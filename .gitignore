# Editor settings
.vscode/

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
backend/dist/
frontend/dist/
backend/coverage/
frontend/coverage/
backend/*.tsbuildinfo
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Generated frontend source companions
frontend/src/**/*.vue.js
frontend/src/router/*.js
frontend/src/services/*.js
frontend/src/stores/*.js
frontend/src/utils/*.js

# Runtime files
backend/*.log
frontend/*.log
backend/*.out.log
frontend/*.out.log
backend/*.err.log
frontend/*.err.log
uploads/

# Environment files
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
